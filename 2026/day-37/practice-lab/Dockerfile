# =====================================================================
# 挑战 [4]: 编写多阶段构建 (Multi-stage) Dockerfile
# 场景：我们需要编译一个 Node.js 应用，最终只保留必要的运行时和依赖，抛弃冗余缓存。
# =====================================================================

# ---------------------------------------------------------------------
# 阶段一：构建阶段 (Builder Stage)
# ---------------------------------------------------------------------
# TODO 1: 请使用体积较大但工具齐全的 Node.js 镜像作为基础镜像，并将其命名为 "builder"
# 提示：FROM <image>:<tag> AS <stage_name>
FROM node:18 AS builder

WORKDIR /usr/src/app

# TODO 2: 为了最大化利用缓存，我们应该先复制什么文件？请写出命令：
COPY package*.json ./

# 安装完整的依赖（包含开发环境所需的编译工具）
RUN npm install

# 复制其余的项目源码
COPY . .

# 假设这里有一个编译步骤（比如将 TypeScript 编译为 JS，或者打包前端代码）
# RUN npm run build

# ---------------------------------------------------------------------
# 阶段二：运行阶段 (Runner Stage)
# ---------------------------------------------------------------------
# TODO 3: 为了让最终镜像体积最小，请在此处选择一个极简的 Node 镜像（如 Alpine 版本）
# 提示：FROM ...
FROM node:18-alpine

WORKDIR /usr/src/app

# TODO 4: 关键步骤！我们需要把阶段一（builder）中准备好的代码和 node_modules 拷贝过来。
# 请使用 --from 选项补全这行命令：
# COPY --from=... <源路径> <目标路径>
COPY --from=builder /usr/src/app ./

# TODO 5: 设置环境变量（比如生产环境标记）
ENV NODE_ENV=production

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["node", "index.js"]
